{
  "manifest_version": 3,
  "name": "Stream to mpv",
  "version": "1.1.0",
  "description": "One-click 'Open in mpv' button directly on HTML5 video players with automatic HLS/MP4 stream detection.",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "stream-to-mpv@talha.dev",
      "strict_min_version": "113.0"
    },
    "gecko_android": {
      "strict_min_version": "113.0"
    }
  },
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Stream to mpv",
    "default_popup": "popup.html"
  }
}
